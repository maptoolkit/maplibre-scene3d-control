{
  "name": "@maptoolkit/maplibre-scene3d-control",
  "version": "0.1.0",
  "description": "A MapLibre GL JS control plugin that adds the 3D scene of a Maptoolkit style: 3D buildings and glTF vegetation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maptoolkit/maplibre-scene3d-control.git"
  },
  "homepage": "https://github.com/maptoolkit/maplibre-scene3d-control#readme",
  "bugs": {
    "url": "https://github.com/maptoolkit/maplibre-scene3d-control/issues"
  },
  "type": "module",
  "module": "./dist/maplibre-scene3d-control.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/maplibre-scene3d-control.js"
    },
    "./style.css": "./dist/maplibre-scene3d-control.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.mts",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "@maptoolkit/maplibre-3d-layers": ">=0.5.0",
    "maplibre-gl": ">=6.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@maptoolkit/maplibre-3d-layers": "^0.5.0",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "maplibre-gl": "^6.9.1",
    "prettier": "^3.9.6",
    "three": "^0.185.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "maplibre",
    "maplibre-gl",
    "map",
    "plugin",
    "control",
    "3d",
    "buildings",
    "gltf"
  ],
  "author": "",
  "license": "BSD-3-Clause"
}
